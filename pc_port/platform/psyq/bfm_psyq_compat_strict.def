/* Strict-only PsyQ lane entries (hand-maintained; not generated).
 *
 * Same BFM_PSYQ(pc, name, status, argc, returns, wrapper) rows as
 * bfm_psyq_compat.def, for Psy-Q routines that no game code calls directly:
 * they are reached only through libgs's own function tables, so they have no
 * jal call sites and no place in the generated table or bfm_psyq_calls.json.
 * native_lane_psyq.c installs them only in MUSASHI_STRICT_NATIVE builds, so
 * the hybrid lane (and its hooked-PC list) is unchanged.
 *
 * GsSortObject5 (0x80055D40) preset sorters: the light-0 (NCCS/NCCT) and
 * light-2 (no lighting) slots of the tables at 0x800A2CF0, wrappers in
 * psyq_psycross.c (gs5_run over the gteRegs bank). */
BFM_PSYQ(0x8004A53C, func_8004A53C, BFM_PSYQ_PSYCROSS, 7, 1, bfm_psyq_gs5_f3_nl)
BFM_PSYQ(0x8004A660, func_8004A660, BFM_PSYQ_PSYCROSS, 7, 1, bfm_psyq_gs5_f3_l)
