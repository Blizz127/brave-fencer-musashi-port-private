 /* The candidate whose member's bytes are resident right now, or NULL. */
+/* MUSASHI_TRACE_LANE_OVERLAY=1: observe-only diagnostics for overlay
+ * entries. It logs the first 16 refusals with the RAM digest and every
+ * candidate, and log-scale counts of why lane_try skipped an
+ * overlay-candidate PC. */
+static int g_lane_suspended; /* tentative; defined below */
+
+static int lane_ovl_trace(void) {
+    static int state = -1;
+    if (state < 0) {
+        const char *v = getenv("MUSASHI_TRACE_LANE_OVERLAY");
+        state = v && v[0] && v[0] != '0';
+    }
+    return state;
+}
+
+static void lane_ovl_count(const char *why, uint64_t *counter, uint32_t pc) {
+    uint64_t n = ++*counter;
+    if (lane_ovl_trace() && (n & (n - 1u)) == 0u) /* 1, 2, 4, 8, ... */
+        fprintf(stderr, "native_boot: LANE_OVERLAY_SKIP why=%s count=%llu last_pc=%08x suspended=%d\n",
+                why, (unsigned long long)n, pc, g_lane_suspended);
+}
+
 static const MusashiNativeLaneEntry *lane_find_overlay(MusashiBootMemory *memory, uint32_t pc) {
     size_t i = lane_ovl_first(pc);
     uint32_t hashed_size = 0;
